{%- comment -%}
  Veltia Labs PDP: main product section (gallery + buy box + sticky add to cart).

  Everything commercial comes from the Shopify product:
    - media              -> gallery
    - variants           -> bundle cards (e.g. "Buy 1", "Buy 2 Get 1 Free", "Buy 3 Get 3 Free")
    - compare_at_price   -> strikethrough price and "Save $X"
    - selling plans      -> Subscribe & Save toggle (Shopify Subscriptions, Recharge, Skio, Loop…)
    - reviews.rating     -> star rating line (synced by Judge.me, Okendo, Yotpo, Loox, Stamped…)

  Optional metafields:
    variant.metafields.custom.bottle_count  integer, bottles in that bundle (for the per-bottle price).
                                            Falls back to the bundle picker's "Bottles per variant" setting.
{%- endcomment -%}

{{ 'pdp-gut-complex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pdp-gut-complex.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'pdp-form-' | append: section.id

  assign picker_block = section.blocks | where: 'type', 'variant_picker' | first
  assign buy_block = section.blocks | where: 'type', 'buy_buttons' | first

  comment
    Pre-select a bundle (e.g. "Buy 2 Get 1 Free") unless the URL already picks a variant.
  endcomment
  assign default_index = picker_block.settings.default_position | minus: 1
  if product.selected_variant == blank and default_index >= 0
    assign default_variant = product.variants[default_index]
    if default_variant.available
      assign current_variant = default_variant
    endif
  endif
  assign bottles_list = picker_block.settings.bottles_list | default: '1' | split: ','

  assign has_plans = false
  if product.selling_plan_groups.size > 0
    assign has_plans = true
  endif
  assign first_plan = product.selling_plan_groups.first.selling_plans.first
  assign selected_plan = current_variant.selected_selling_plan_allocation.selling_plan
  assign start_subscribed = false
  if selected_plan
    assign start_subscribed = true
  elsif has_plans and section.settings.default_subscribe
    assign start_subscribed = true
    assign selected_plan = first_plan
  elsif product.requires_selling_plan
    assign start_subscribed = true
    assign selected_plan = first_plan
  endif

  comment
    The "offer" is what the buy box shows: the selected variant, or, for a single-variant product
    sold in quantity tiers (Kaching-style bundles), the pre-selected tier.
  endcomment
  assign tier_mode = false
  if product.has_only_default_variant and picker_block.settings.tier_1_title != blank
    assign tier_mode = true
  endif
  assign offer_qty = 1
  assign offer_price = current_variant.price
  assign offer_compare = current_variant.compare_at_price | default: 0
  assign offer_position = 1
  for v in product.variants
    if v.id == current_variant.id
      assign offer_position = forloop.index
    endif
  endfor
  if tier_mode
    assign offer_position = picker_block.settings.default_position | at_least: 1
    assign q_key = 'tier_' | append: offer_position | append: '_qty'
    assign p_key = 'tier_' | append: offer_position | append: '_price'
    assign offer_qty = picker_block.settings[q_key] | at_least: 1
    assign offer_price = picker_block.settings[p_key] | times: 100 | round
    if offer_price == 0
      assign offer_price = current_variant.price | times: offer_qty
    endif
    if picker_block.settings.round_99
      assign offer_price = offer_price | plus: 1 | divided_by: 100.0 | ceil | times: 100 | minus: 1
    endif
    assign offer_compare = current_variant.compare_at_price | default: current_variant.price | times: offer_qty
  endif
  assign current_savings = offer_compare | minus: offer_price | at_least: 0

  comment
    Bundle app mode: an app block (e.g. Kaching Bundles) replaces the Bundle picker, so the app owns the
    quantity and price. Our price line and the sticky bar's price would only show the single-bottle price,
    so they're hidden rather than disagree with the app.
  endcomment
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign bundle_app = false
  if picker_block == blank and app_blocks.size > 0
    assign bundle_app = true
  endif
-%}

<pdp-product
  class="pdp-scope pdp-main"
  id="PdpMain-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-after-add="{{ section.settings.after_add }}"
  data-money-format="{{ shop.money_format | strip_html | escape }}"
  data-cart-url="{{ routes.cart_url }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-checkout-url="/checkout"
  {%- if bundle_app %} data-bundle-app{% endif %}
  {%- liquid
    assign bar_images = ''
    for i in (1..3)
      assign key = 'bundle_app_image_' | append: i
      if section.settings[key] != blank
        assign url = section.settings[key] | image_url: width: 240
        assign bar_images = bar_images | append: url
      endif
      assign bar_images = bar_images | append: '|'
    endfor
  -%}
  {%- if bundle_app and bar_images != '|||' %} data-bar-images="{{ bar_images }}"{% endif %}
  style="--pdp-accent: {{ section.settings.accent }}; --pdp-accent-dark: {{ section.settings.accent_dark }}; --pdp-highlight: {{ section.settings.highlight }}; --pdp-bg: {{ section.settings.background }};"
>
  <span id="PdpTop" class="pdp-anchor"></span>
  <div class="pdp-container pdp-main__grid">
    {%- render 'pdp-gallery', product: product, settings: section.settings -%}

    {%- comment -%} ================= Buy box ================= {%- endcomment -%}
    <div class="pdp-info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'rating' -%}
            {%- liquid
              assign rating = product.metafields.reviews.rating.value
              assign rating_count = product.metafields.reviews.rating_count.value | default: 0
              assign rating_value = rating.rating | default: block.settings.fallback_rating
              assign rating_max = rating.scale_max | default: 5
              assign pct = rating_value | times: 100.0 | divided_by: rating_max
              assign rating_word = block.settings.word_good
              assign rating_num = rating_value | times: 1.0
              if rating_num >= 4.5
                assign rating_word = block.settings.word_excellent
              elsif rating_num >= 4
                assign rating_word = block.settings.word_great
              endif
            -%}
            {%- if rating != blank or block.settings.fallback_rating > 0 -%}
              <a class="pdp-rating" href="#{{ block.settings.anchor | default: 'reviews' }}" {{ block.shopify_attributes }}>
                <span class="pdp-stars" style="--pdp-fill: {{ pct }}%;" aria-hidden="true">
                  <span class="pdp-stars__base">{% for i in (1..5) %}{% render 'pdp-icon', name: 'star' %}{% endfor %}</span>
                  <span class="pdp-stars__fill">{% for i in (1..5) %}{% render 'pdp-icon', name: 'star' %}{% endfor %}</span>
                </span>
                <span class="pdp-rating__text">
                  Rated {{ rating_value | round: 1 }}
                  {%- if block.settings.count_label != blank %} · <strong>{{ block.settings.count_label }}</strong>
                  {%- else -%}
                    {%- if rating_word != blank %} <strong>“{{ rating_word }}”</strong>{% endif -%}
                    {%- if rating_count > 0 and block.settings.show_count %} · {{ rating_count }} reviews{% endif -%}
                  {%- endif -%}
                  <span class="visually-hidden">out of {{ rating_max }} stars</span>
                </span>
              </a>
            {%- endif -%}

          {%- when 'title' -%}
            <div class="pdp-info__head" {{ block.shopify_attributes }}>
              {%- if section.settings.badge_placement == 'title' and section.settings.gallery_badge != blank -%}
                <span class="pdp-title-badge">{{ section.settings.gallery_badge }}</span>
              {%- endif -%}
              {%- if block.settings.eyebrow != blank -%}
                <p class="pdp-eyebrow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}
              <h1 class="pdp-title">
                {%- if block.settings.headline != blank -%}
                  <span class="visually-hidden">{{ product.title }}: </span>{{ block.settings.headline }}
                {%- else -%}
                  {{ product.title }}
                {%- endif -%}
              </h1>
              {%- if block.settings.intro != blank -%}
                <div class="pdp-intro pdp-rte">{{ block.settings.intro }}</div>
              {%- endif -%}
            </div>

          {%- when 'text' -%}
            <div class="pdp-rte pdp-info__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'benefits' -%}
            <ul class="pdp-benefits-grid" role="list" {{ block.shopify_attributes }}>
              {%- for i in (1..6) -%}
                {%- liquid
                  assign b_text = 'benefit_' | append: i | append: '_text'
                  assign b_icon = 'benefit_' | append: i | append: '_icon'
                -%}
                {%- if block.settings[b_text] != blank -%}
                  <li>{% render 'pdp-icon', name: block.settings[b_icon] %}<span>{{ block.settings[b_text] }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'stock_bar' -%}
            {%- liquid
              assign sold_pct = block.settings.percent_sold
              if block.settings.use_inventory and current_variant.inventory_management == 'shopify' and block.settings.starting_stock > 0
                assign remaining = current_variant.inventory_quantity | at_least: 0
                assign sold = block.settings.starting_stock | minus: remaining | at_least: 0
                assign sold_pct = sold | times: 100 | divided_by: block.settings.starting_stock | at_most: 99
              endif
            -%}
            <div class="pdp-stock" {{ block.shopify_attributes }}>
              <div class="pdp-stock__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ sold_pct }}" aria-label="{{ block.settings.label | escape }}">
                <span style="width: {{ sold_pct }}%;"></span>
              </div>
              <span class="pdp-stock__label">{{ sold_pct }}% {{ block.settings.label }}</span>
            </div>

          {%- when 'price' -%}
            {%- if bundle_app -%}
              {%- comment -%} Filled from the bundle app's selected deal by pdp-gut-complex.js; hidden until then. {%- endcomment -%}
              <div class="pdp-price" data-bundle-price hidden {{ block.shopify_attributes }}>
                <span class="pdp-price__current" data-bundle-now></span>
                <s class="pdp-price__compare" data-bundle-was hidden></s>
                {%- if block.settings.sale_label != blank -%}
                  <span class="pdp-price__pill" data-bundle-pill data-template="{{ block.settings.sale_label | escape }}" hidden></span>
                {%- endif -%}
              </div>
              {%- continue -%}
            {%- endif -%}
            <div class="pdp-price" {{ block.shopify_attributes }}>
              <span class="pdp-price__current" data-price>{{ offer_price | money }}</span>
              <s class="pdp-price__compare" data-compare{% if current_savings == 0 %} hidden{% endif %}>{{ offer_compare | money }}</s>
              {%- if block.settings.sale_label != blank -%}
                <span class="pdp-price__pill" data-sale-pill data-template="{{ block.settings.sale_label | escape }}"{% if current_savings == 0 %} hidden{% endif %}>
                  {%- assign current_savings_money = current_savings | money -%}
                  {{- block.settings.sale_label | replace: '[savings]', current_savings_money -}}
                </span>
              {%- endif -%}
            </div>

          {%- when 'variant_picker' -%}
            {%- if product.has_only_default_variant == false or tier_mode -%}
              {%- render 'pdp-bundles', product: product, block: block, current_variant: current_variant, section_id: section.id, bottles_list: bottles_list, offer_position: offer_position -%}
            {%- endif -%}

          {%- when 'gifts' -%}
            <div class="pdp-gifts" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="pdp-gifts__heading">{{ block.settings.heading }}</p>
              {%- endif -%}
              <ul class="pdp-gifts__list" role="list">
                {%- for i in (1..3) -%}
                  {%- liquid
                    assign g_title = 'gift_' | append: i | append: '_title'
                    assign g_tag = 'gift_' | append: i | append: '_tag'
                    assign g_icon = 'gift_' | append: i | append: '_icon'
                    assign g_image = 'gift_' | append: i | append: '_image'
                    assign g_unlock = 'gift_' | append: i | append: '_unlock'
                    assign g_value = 'gift_' | append: i | append: '_value'
                  -%}
                  {%- if block.settings[g_title] != blank -%}
                    <li class="pdp-gift" data-gift-unlock="{{ block.settings[g_unlock] }}">
                      {%- if block.settings[g_tag] != blank -%}
                        <span class="pdp-gift__tag">
                          {{- block.settings[g_tag] -}}
                          {%- if block.settings[g_value] != blank %} <s class="pdp-gift__value">{{ block.settings[g_value] }}</s>{% endif -%}
                        </span>
                      {%- endif -%}
                      <span class="pdp-gift__media">
                        {%- if block.settings[g_image] != blank -%}
                          {{- block.settings[g_image] | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' -}}
                        {%- else -%}
                          {%- render 'pdp-icon', name: block.settings[g_icon] -%}
                        {%- endif -%}
                        <span class="pdp-gift__lock">{% render 'pdp-icon', name: 'lock' %}</span>
                      </span>
                      <span class="pdp-gift__title">{{ block.settings[g_title] }}</span>
                      <span class="pdp-gift__locked-text">{{ block.settings.locked_text }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'delivery' -%}
            <p
              class="pdp-delivery"
              data-delivery
              data-min-days="{{ block.settings.min_days }}"
              data-max-days="{{ block.settings.max_days }}"
              data-cutoff-hour="{{ block.settings.cutoff_hour }}"
              hidden
              {{ block.shopify_attributes }}
            >
              {%- render 'pdp-icon', name: 'calendar' -%}
              <span>{{ block.settings.text }} <strong data-delivery-date></strong></span>
            </p>

          {%- when 'stock_bar' -%}
            {%- assign sold = block.settings.percent -%}
            {%- assign sold_pct = sold | append: '%' -%}
            <div class="pdp-stock" style="--pdp-stock: {{ sold }}%;" {{ block.shopify_attributes }}>
              <p class="pdp-stock__text">
                <span>{{ block.settings.text | replace: '[percent]', sold_pct }}</span>
                {%- if block.settings.note != blank -%}<strong>{{ block.settings.note | replace: '[percent]', sold_pct }}</strong>{%- endif -%}
              </p>
              <div class="pdp-stock__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ sold }}" aria-label="{{ sold_pct }} sold">
                <span class="pdp-stock__fill"></span>
              </div>
            </div>

          {%- when 'purchase_options' -%}
            {%- if has_plans -%}
              <div class="pdp-subscribe"{% if block.settings.single_only %} data-single-only{% endif %} {{ block.shopify_attributes }}>
                <label class="pdp-subscribe__toggle">
                  <input
                    type="checkbox"
                    class="pdp-check"
                    data-subscribe-toggle
                    {% if start_subscribed %}checked{% endif %}
                    {% if product.requires_selling_plan %}disabled{% endif %}
                  >
                  <span class="pdp-subscribe__text">
                    <strong>{{ block.settings.subscribe_label }}</strong>
                    <span class="pdp-pill" data-sub-save hidden>Save <span data-sub-save-pct></span>%</span>
                    {%- if block.settings.subscribe_sub != blank -%}
                      <span class="pdp-subscribe__perks">
                        {%- assign perks = block.settings.subscribe_sub | split: '|' -%}
                        {%- for perk in perks -%}
                          <span class="pdp-subscribe__perk">{% render 'pdp-icon', name: 'refresh' %}{{ perk | strip }}</span>
                        {%- endfor -%}
                      </span>
                    {%- endif -%}
                    {%- if block.settings.single_only and block.settings.single_note != blank -%}
                      <span class="pdp-subscribe__note" data-sub-note hidden>{{ block.settings.single_note }}</span>
                    {%- endif -%}
                  </span>
                </label>
                <label class="pdp-select pdp-select--inline" data-plan-wrap{% unless start_subscribed %} hidden{% endunless %}>
                  <span class="pdp-select__label">{{ block.settings.frequency_label }}</span>
                  <select data-plan-select>
                    {%- for group in product.selling_plan_groups -%}
                      {%- for plan in group.selling_plans -%}
                        <option value="{{ plan.id }}" {% if selected_plan and plan.id == selected_plan.id %}selected{% endif %}>{{ plan.name }}</option>
                      {%- endfor -%}
                    {%- endfor -%}
                  </select>
                  {%- render 'pdp-icon', name: 'chevron' -%}
                </label>
              </div>
            {%- endif -%}

          {%- when 'buy_buttons' -%}
            <div class="pdp-buy" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'pdp-buy__form', novalidate: 'novalidate', data-pdp-form: '' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>
                <input type="hidden" name="selling_plan" value="{% if start_subscribed and selected_plan %}{{ selected_plan.id }}{% endif %}" data-plan-input>

                <div class="pdp-buy__row">
                  {%- if block.settings.show_quantity -%}
                    <div class="pdp-qty">
                      <button type="button" class="pdp-qty__btn" data-qty-minus aria-label="Decrease quantity">{% render 'pdp-icon', name: 'minus' %}</button>
                      <input class="pdp-qty__input" type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric" aria-label="Quantity" data-qty-input>
                      <button type="button" class="pdp-qty__btn" data-qty-plus aria-label="Increase quantity">{% render 'pdp-icon', name: 'plus' %}</button>
                    </div>
                  {%- else -%}
                    <input type="hidden" name="quantity" value="{{ offer_qty }}" data-qty-input>
                  {%- endif -%}

                  {%- assign subtext_inside = false -%}
                  {%- if block.settings.subtext != blank and block.settings.subtext_inside -%}{%- assign subtext_inside = true -%}{%- endif -%}
                  <button type="submit" name="add" class="pdp-btn pdp-btn--primary pdp-buy__atc{% if subtext_inside %} pdp-buy__atc--sub{% endif %}" data-atc {% unless current_variant.available %}disabled{% endunless %}>
                    <span class="pdp-btn__row">
                      <span class="pdp-btn__label" data-atc-label>
                        {%- if current_variant.available -%}{{ block.settings.atc_label }}{%- else -%}Sold out{%- endif -%}
                      </span>
                      <span class="pdp-btn__sep" aria-hidden="true"></span>
                      <span class="pdp-btn__price">
                        <span data-atc-price>{{ offer_price | money }}</span>
                        <s data-atc-compare{% if current_savings == 0 %} hidden{% endif %}>{{ offer_compare | money }}</s>
                      </span>
                    </span>
                    {%- if subtext_inside -%}<span class="pdp-btn__sub">{{ block.settings.subtext }}</span>{%- endif -%}
                    <span class="pdp-btn__spinner" aria-hidden="true"></span>
                  </button>
                </div>

                {%- if block.settings.subtext != blank and subtext_inside == false -%}
                  <p class="pdp-buy__subtext">{% render 'pdp-icon', name: 'shield' %}{{ block.settings.subtext }}</p>
                {%- endif -%}

                {%- if block.settings.show_dynamic_checkout -%}
                  <div class="pdp-buy__dynamic">{{ form | payment_button }}</div>
                {%- endif -%}

                <p class="pdp-buy__error" role="alert" data-atc-error hidden></p>
                <p class="pdp-buy__success" role="status" data-atc-success hidden>Added to your cart. <a href="{{ routes.cart_url }}">View cart</a></p>
              {%- endform -%}
            </div>

          {%- when 'payment_icons' -%}
            <ul class="pdp-payments" role="list" {{ block.shopify_attributes }}>
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'pdp-payments__icon' }}</li>
              {%- endfor -%}
            </ul>

          {%- when 'social_proof' -%}
            <div class="pdp-proof" {{ block.shopify_attributes }}>
              <span class="pdp-proof__avatars">
                {%- for i in (1..4) -%}
                  {%- assign a_key = 'avatar_' | append: i -%}
                  {%- if block.settings[a_key] != blank -%}
                    {{- block.settings[a_key] | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' -}}
                  {%- endif -%}
                {%- endfor -%}
              </span>
              <span class="pdp-proof__text">
                <strong>{{ block.settings.heading }}</strong>
                {%- if block.settings.subheading != blank -%}<span>{{ block.settings.subheading }}</span>{%- endif -%}
              </span>
            </div>

          {%- when 'guarantee' -%}
            <div class="pdp-guarantee" {{ block.shopify_attributes }}>
              <span class="pdp-guarantee__seal">
                {%- if block.settings.image != blank -%}
                  {{- block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' -}}
                {%- else -%}
                  <span class="pdp-guarantee__days">{{ block.settings.days }}</span><span class="pdp-guarantee__unit">day</span>
                {%- endif -%}
              </span>
              <span class="pdp-guarantee__text">
                <strong>{{ block.settings.heading }}</strong>
                <span>{{ block.settings.text }}</span>
              </span>
            </div>

          {%- when 'trust_badges' -%}
            <ul class="pdp-trust" role="list" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- liquid
                  assign t_key = 'badge_' | append: i | append: '_text'
                  assign i_key = 'badge_' | append: i | append: '_icon'
                -%}
                {%- if block.settings[t_key] != blank -%}
                  <li class="pdp-trust__item">{% render 'pdp-icon', name: block.settings[i_key] %}<span>{{ block.settings[t_key] }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'collapsible' -%}
            <details class="pdp-accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary class="pdp-accordion__summary">
                <span>{{ block.settings.heading }}</span>
                <span class="pdp-accordion__icon" aria-hidden="true">{% render 'pdp-icon', name: 'plus' %}</span>
              </summary>
              <div class="pdp-accordion__body pdp-rte">
                {%- case block.settings.source -%}
                  {%- when 'description' -%}
                    {{ product.description }}
                  {%- when 'page' -%}
                    {{ block.settings.page.content }}
                  {%- else -%}
                    {{ block.settings.content }}
                {%- endcase -%}
              </div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.show_sticky -%}
    <div class="pdp-sticky" data-sticky>
      <div class="pdp-container pdp-sticky__inner">
        <div class="pdp-sticky__product">
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'pdp-sticky__img', alt: '' }}
          {%- endif -%}
          <div class="pdp-sticky__copy">
            <p class="pdp-sticky__title">{{ product.title }}</p>
            <p class="pdp-sticky__meta" data-sticky-variant>{% unless product.has_only_default_variant %}{{ current_variant.title }}{% endunless %}</p>
          </div>
        </div>
        <button type="button" class="pdp-btn pdp-btn--primary pdp-sticky__btn" data-sticky-atc tabindex="-1" {% unless current_variant.available %}disabled{% endunless %}>
          <span data-sticky-label>{%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}</span>
          {%- unless bundle_app -%}
            <span class="pdp-btn__sep" aria-hidden="true"></span>
            <span data-sticky-price>{{ offer_price | money }}</span>
          {%- endunless -%}
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Variant + selling plan data for pdp-gut-complex.js {%- endcomment -%}
  <script type="application/json" data-pdp-json>
    {
      "atcLabel": {{ buy_block.settings.atc_label | default: 'Add to cart' | json }},
      "variants": [
        {%- for variant in product.variants -%}
          {%- assign fallback_bottles = bottles_list[forloop.index0] | default: bottles_list.last | strip | plus: 0 -%}
          {
            "id": {{ variant.id | json }},
            "position": {{ forloop.index | json }},
            "title": {{ variant.title | json }},
            "options": {{ variant.options | json }},
            "available": {{ variant.available | json }},
            "price": {{ variant.price | json }},
            "compareAtPrice": {{ variant.compare_at_price | default: 0 | json }},
            "bottles": {{ variant.metafields.custom.bottle_count.value | default: fallback_bottles | json }},
            "mediaId": {{ variant.featured_media.id | default: 0 | json }},
            "plans": {
              {%- for alloc in variant.selling_plan_allocations -%}
                "{{ alloc.selling_plan.id }}": {{ alloc.price | json }}{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</pdp-product>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

