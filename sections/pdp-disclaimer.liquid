{{ 'pdp-gut-complex.css' | asset_url | stylesheet_tag }}

<div class="pdp-scope pdp-disclaimer">
  <div class="pdp-container pdp-container--narrow">
    <p>{{ section.settings.text }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Gut Complex: disclaimer",
  "tag": "section",
  "class": "section-pdp-disclaimer",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Disclaimer",
      "default": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Consult your healthcare provider before use if you are pregnant, nursing, taking medication, or have a medical condition. Individual results may vary."
    }
  ],
  "presets": [{ "name": "Gut Complex: disclaimer" }]
}
{% endschema %}
