{{ 'pdp-gut-complex.css' | asset_url | stylesheet_tag }}

<div class="pdp-scope pdp-disclaimer">
  <div class="pdp-container pdp-container--narrow">
    <p>{{ section.settings.text }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Veltia: disclaimer",
  "tag": "section",
  "class": "section-pdp-disclaimer",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Disclaimer",
      "default": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Individual results may vary. This information is for general education only and is not medical advice. Talk to your healthcare provider before starting any supplement, especially if you are pregnant, nursing, taking medication, or managing a medical condition."
    }
  ],
  "presets": [{ "name": "Veltia: disclaimer" }]
}
{% endschema %}
