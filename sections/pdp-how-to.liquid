{%- comment -%}
  How to take it: numbered steps beside a product image, plus an optional tip.
  Keep the steps in line with the label's directions.
{%- endcomment -%}
{{ 'pdp-gut-complex.css' | asset_url | stylesheet_tag }}

<section class="pdp-scope pdp-section pdp-howto" style="--pdp-section-bg: {{ section.settings.bg }};">
  <div class="pdp-container pdp-howto__grid">
    {%- if section.settings.image != blank -%}
      <div class="pdp-howto__media">
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 40vw, 92vw', widths: '400, 600, 900', alt: section.settings.image.alt }}
      </div>
    {%- endif -%}
    <div class="pdp-howto__copy">
      {%- if section.settings.kicker != blank -%}<p class="pdp-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="pdp-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="pdp-section__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      <ol class="pdp-howto__steps" role="list">
        {%- for block in section.blocks -%}
          <li class="pdp-howto__step" {{ block.shopify_attributes }}>
            <span class="pdp-howto__num" aria-hidden="true">{{ forloop.index }}</span>
            <div>
              <p class="pdp-howto__title">{{ block.settings.title }}</p>
              {%- if block.settings.text != blank -%}<p class="pdp-howto__text">{{ block.settings.text }}</p>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
      {%- if section.settings.tip != blank -%}
        <p class="pdp-howto__tip">{% render 'pdp-icon', name: 'drop' %}<span>{{ section.settings.tip }}</span></p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Veltia: how to take it",
  "tag": "section",
  "class": "section-pdp-howto",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Your daily ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to take it" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Takes about ten seconds a day." },
    { "type": "text", "id": "tip", "label": "Tip" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Veltia: how to take it",
      "blocks": [
        { "type": "step", "settings": { "title": "Shake the bottle", "text": "The herbs settle, so give it a good shake first." } },
        { "type": "step", "settings": { "title": "Start with a few drops", "text": "Add them to a little water or juice, once a day." } },
        { "type": "step", "settings": { "title": "Build up to a full dropper", "text": "Over the first week or two, or follow the label." } }
      ]
    }
  ]
}
{% endschema %}
