{{ 'pdp-gut-complex.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pdp-gut-complex.js' | asset_url }}" defer="defer"></script>

<section class="pdp-scope pdp-section pdp-ingr" id="ingredients" style="--pdp-section-bg: {{ section.settings.bg }};">
  <div class="pdp-container">
    <div class="pdp-center pdp-section__head">
      <h2 class="pdp-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="pdp-section__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <ul class="pdp-ingr__grid" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <button type="button" class="pdp-flip" data-flip-card aria-pressed="false" aria-label="{{ block.settings.name | escape }}: show benefits and dosage">
            <span class="pdp-flip__inner">
              <span class="pdp-flip__face pdp-flip__front">
                <span class="pdp-flip__media">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '300, 450, 600', alt: '' }}
                  {%- else -%}
                    <span class="pdp-flip__placeholder">{% render 'pdp-icon', name: 'leaf' %}</span>
                  {%- endif -%}
                </span>
                <span class="pdp-flip__name">{{ block.settings.name }}</span>
                <span class="pdp-flip__hint" aria-hidden="true">{% render 'pdp-icon', name: 'refresh' %}</span>
              </span>
              <span class="pdp-flip__face pdp-flip__back">
                {%- if block.settings.tag != blank -%}<span class="pdp-flip__tag">{{ block.settings.tag }}</span>{%- endif -%}
                <span class="pdp-flip__name">{{ block.settings.name }}</span>
                <span class="pdp-flip__benefit">{{ block.settings.benefit }}</span>
                {%- if block.settings.dose != blank -%}
                  <span class="pdp-flip__dose"><small>{{ section.settings.dose_label }}</small>{{ block.settings.dose }}</span>
                {%- endif -%}
              </span>
            </span>
          </button>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.facts_note != blank -%}
      <p class="pdp-ingr__note">{{ section.settings.facts_note }}</p>
    {%- endif -%}

    {%- if section.settings.facts_image != blank -%}
      <details class="pdp-accordion pdp-ingr__facts">
        <summary class="pdp-accordion__summary">
          <span>{{ section.settings.facts_label }}</span>
          <span class="pdp-accordion__icon" aria-hidden="true">{% render 'pdp-icon', name: 'plus' %}</span>
        </summary>
        <div class="pdp-accordion__body">
          {{ section.settings.facts_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.facts_label }}
        </div>
      </details>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Veltia: ingredients",
  "tag": "section",
  "class": "section-pdp-ingredients",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "7 Herbs. 1 Daily Dropper." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Tap a card to see what it does" },
    { "type": "text", "id": "dose_label", "label": "Dose label on card back", "default": "Key compound" },
    { "type": "text", "id": "facts_note", "label": "Note under cards", "default": "All 7 herbs are in every dropper. See the label for amounts." },
    { "type": "image_picker", "id": "facts_image", "label": "Supplement Facts panel image" },
    { "type": "text", "id": "facts_label", "label": "Supplement Facts label", "default": "View Supplement Facts" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F6EEE2" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Ingredient" },
        { "type": "text", "id": "tag", "label": "Benefit tag", "info": "e.g. Shield Breaker" },
        { "type": "textarea", "id": "benefit", "label": "Benefit (back of card)" },
        { "type": "text", "id": "dose", "label": "Key compound / dose", "info": "Match your Supplement Facts panel, e.g. Allicin." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Veltia: ingredients",
      "blocks": [
        {"type": "ingredient", "settings": {"name": "Garlic", "tag": "Shield Breaker", "dose": "Allicin", "benefit": "Has allicin. Lab studies show it can help break down the shield bacteria hide behind.*"}},
        {"type": "ingredient", "settings": {"name": "Oregano", "tag": "Microbial Balance", "dose": "Carvacrol", "benefit": "Helps clear unwanted microbes once the shield is down.*"}},
        {"type": "ingredient", "settings": {"name": "Black Walnut", "tag": "Traditional Cleanse Herb", "dose": "Juglone", "benefit": "Used for generations in herbal cleanses to support a healthy gut.*"}},
        {"type": "ingredient", "settings": {"name": "Wormwood", "tag": "Digestive Bitter", "dose": "Absinthin", "benefit": "A very bitter herb, used for centuries to support digestion.*"}},
        {"type": "ingredient", "settings": {"name": "Pau D'Arco", "tag": "Gut Flora Support", "dose": "Lapachol", "benefit": "Tree bark from South America, used to support healthy gut flora.*"}},
        {"type": "ingredient", "settings": {"name": "Pumpkin Seed", "tag": "Traditional Support", "dose": "Cucurbitin", "benefit": "A classic herbal cleanse ingredient for gut health.*"}},
        {"type": "ingredient", "settings": {"name": "Soursop", "tag": "Traditional Botanical", "dose": "", "benefit": "A tropical leaf used in traditional remedies for digestion.*"}}
      ]
    }
  ]
}
{% endschema %}
