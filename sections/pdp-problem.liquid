{{ 'pdp-gut-complex.css' | asset_url | stylesheet_tag }}

<section class="pdp-scope pdp-section pdp-problem" style="--pdp-section-bg: {{ section.settings.bg }}; --pdp-highlight: {{ section.settings.accent }};">
  {%- comment -%} Without an image the copy runs as one centered column instead of leaving an empty box. {%- endcomment -%}
  <div class="pdp-container pdp-problem__grid{% if section.settings.image == blank %} pdp-problem__grid--solo{% endif %}">
    {%- if section.settings.image != blank -%}
      <div class="pdp-problem__media">
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: section.settings.image.alt }}
      </div>
    {%- endif -%}
    <div class="pdp-problem__copy">
      {%- if section.settings.kicker != blank -%}<p class="pdp-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="pdp-h2">
        {{- section.settings.heading -}}
        {%- if section.settings.heading_highlight != blank %} <em>{{ section.settings.heading_highlight }}</em>{% endif -%}
      </h2>
      <div class="pdp-rte">{{ section.settings.body }}</div>
      {%- if section.blocks.size > 0 -%}
        {%- if section.settings.list_heading != blank -%}<p class="pdp-problem__list-heading">{{ section.settings.list_heading }}</p>{%- endif -%}
        <ul class="pdp-xlist" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'pdp-icon', name: 'cross' %}<span>{{ block.settings.text }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Veltia: problem",
  "tag": "section",
  "class": "section-pdp-problem",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Reason Your Bloating Keeps Coming Back" },
    { "type": "text", "id": "heading_highlight", "label": "Heading highlight", "default": "Is Not What You Were Told" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Bad bacteria don't just sit in your gut.</p><p>Over time they hide under a slimy layer called biofilm. Think of it as a shield.</p><p>Diets, probiotics and treatments hit the bacteria out in the open. The ones under the shield survive. Then they grow back. And so does your bloating.</p>"
    },
    { "type": "text", "id": "list_heading", "label": "List heading", "default": "Sound familiar?" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#2B1C12" },
    { "type": "color", "id": "accent", "label": "Highlight color", "default": "#E0A55A" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Pain point",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Pain point" }]
    }
  ],
  "presets": [
    {
      "name": "Veltia: problem",
      "blocks": [
        {"type": "item", "settings": {"text": "Bloating that keeps coming back"}},
        {"type": "item", "settings": {"text": "Treatments that work, then stop"}},
        {"type": "item", "settings": {"text": "Probiotics that make it worse"}},
        {"type": "item", "settings": {"text": "Flat in the morning, bloated by dinner"}}
      ]
    }
  ]
}
{% endschema %}
