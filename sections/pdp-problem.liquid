{{ 'pdp-gut-complex.css' | asset_url | stylesheet_tag }}

<section class="pdp-scope pdp-section pdp-problem" style="--pdp-section-bg: {{ section.settings.bg }}; --pdp-highlight: {{ section.settings.accent }};">
  <div class="pdp-container pdp-problem__grid">
    <div class="pdp-problem__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: section.settings.image.alt }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'pdp-placeholder' }}
      {%- endif -%}
    </div>
    <div class="pdp-problem__copy">
      {%- if section.settings.kicker != blank -%}<p class="pdp-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="pdp-h2">
        {{- section.settings.heading -}}
        {%- if section.settings.heading_highlight != blank %} <em>{{ section.settings.heading_highlight }}</em>{% endif -%}
      </h2>
      <div class="pdp-rte">{{ section.settings.body }}</div>
      {%- if section.blocks.size > 0 -%}
        {%- if section.settings.list_heading != blank -%}<p class="pdp-problem__list-heading">{{ section.settings.list_heading }}</p>{%- endif -%}
        <ul class="pdp-xlist" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'pdp-icon', name: 'cross' %}<span>{{ block.settings.text }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gut Complex: problem",
  "tag": "section",
  "class": "section-pdp-problem",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Reason Your Gut Never Fully Resets" },
    { "type": "text", "id": "heading_highlight", "label": "Heading highlight", "default": "Is Not What You Were Told" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Your small intestine has a built-in cleaning system: a wave of contractions that sweeps bacteria out between meals. Stress, medications and diet can slow it down. Bacteria accumulate, and the longer they stay, the thicker the protective shield they build around themselves, called biofilm, to avoid being cleared out.</p><p>A cycle that rarely stops on its own.</p>"
    },
    { "type": "text", "id": "list_heading", "label": "List heading", "default": "Sound familiar?" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#16291D" },
    { "type": "color", "id": "accent", "label": "Highlight color", "default": "#C8A44D" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Pain point",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Pain point" }]
    }
  ],
  "presets": [
    {
      "name": "Gut Complex: problem",
      "blocks": [
        { "type": "item", "settings": { "text": "Bloating and urgency that come back no matter what you try" } },
        { "type": "item", "settings": { "text": "Antibiotics that work for a few weeks, then stop" } },
        { "type": "item", "settings": { "text": "Probiotics that make things worse, not better" } },
        { "type": "item", "settings": { "text": "A gut that feels off even when tests come back normal" } }
      ]
    }
  ]
}
{% endschema %}
