{{ 'pdp-gut-complex.css' | asset_url | stylesheet_tag }}

<section class="pdp-scope pdp-section pdp-trustsec" style="--pdp-section-bg: {{ section.settings.bg }};">
  <div class="pdp-container pdp-container--narrow">
    <h2 class="pdp-h2 pdp-center">{{ section.settings.heading }}</h2>

    {%- assign badge_blocks = section.blocks | where: 'type', 'badge' -%}
    {%- if badge_blocks.size > 0 -%}
      <ul class="pdp-trustsec__badges" role="list">
        {%- for block in badge_blocks -%}
          <li class="pdp-trustsec__badge" {{ block.shopify_attributes }}>
            <span class="pdp-trustsec__seal">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.label }}
              {%- else -%}
                {%- render 'pdp-icon', name: block.settings.icon -%}
              {%- endif -%}
            </span>
            <span class="pdp-trustsec__label">{{ block.settings.label }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- assign free_blocks = section.blocks | where: 'type', 'free_from' -%}
    {%- if free_blocks.size > 0 -%}
      <ul class="pdp-trustsec__list" role="list">
        {%- for block in free_blocks -%}
          <li {{ block.shopify_attributes }}>{% render 'pdp-icon', name: 'check' %}<span>{{ block.settings.text }}</span></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Gut Complex: why trust",
  "tag": "section",
  "class": "section-pdp-trust",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Trust Us as Your Wellness Partner?" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F4F1EA" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Seal image" },
        { "type": "select", "id": "icon", "label": "Icon (if no image)", "default": "usa", "options": [ { "value": "usa", "label": "USA" }, { "value": "gmp", "label": "Certified" }, { "value": "flask", "label": "Lab tested" }, { "value": "leaf", "label": "Leaf" }, { "value": "shield", "label": "Shield" }, { "value": "drop", "label": "Drop" } ] },
        { "type": "text", "id": "label", "label": "Label", "default": "Made in USA" }
      ]
    },
    {
      "type": "free_from",
      "name": "Checklist item",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Vegan-Friendly" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gut Complex: why trust",
      "blocks": [
        { "type": "badge", "settings": { "label": "Made in USA", "icon": "usa" } },
        { "type": "badge", "settings": { "label": "Third-Party Tested", "icon": "flask" } },
        { "type": "badge", "settings": { "label": "Clean Formula", "icon": "leaf" } },
        { "type": "badge", "settings": { "label": "GMP Certified Facility", "icon": "gmp" } },
        { "type": "free_from", "settings": { "text": "Vegan-Friendly" } },
        { "type": "free_from", "settings": { "text": "No Artificial Additives" } },
        { "type": "free_from", "settings": { "text": "Allergen-Free" } },
        { "type": "free_from", "settings": { "text": "No Added Sugar" } },
        { "type": "free_from", "settings": { "text": "No Artificial Flavors" } },
        { "type": "free_from", "settings": { "text": "Gluten-Free" } }
      ]
    }
  ]
}
{% endschema %}
