{%- comment -%}
  Renders an inline line icon.
  Usage: {% render 'pdp-icon', name: 'leaf' %}
{%- endcomment -%}
<svg class="pdp-icon pdp-icon--{{ name }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'check' -%}
      <path d="M5 12.5l4.2 4.2L19 7"/>
    {%- when 'cross' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'star' -%}
      <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" fill="currentColor" stroke="none"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19c3-4 6-6.5 9.5-8.5"/>
    {%- when 'drop' -%}
      <path d="M12 3.5s6 6.4 6 10.6a6 6 0 01-12 0C6 9.9 12 3.5 12 3.5z"/>
    {%- when 'shield' -%}
      <path d="M12 3l7 3v5.5c0 4.6-3 8-7 9.5-4-1.5-7-4.9-7-9.5V6z"/><path d="M8.8 12l2.2 2.2 4.2-4.4"/>
    {%- when 'truck' -%}
      <path d="M3 6.5h11v9H3zM14 9.5h3.6L21 13v2.5h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'refresh' -%}
      <path d="M20 11a8 8 0 00-14.6-4.4M4 5v4h4M4 13a8 8 0 0014.6 4.4M20 19v-4h-4"/>
    {%- when 'gut' -%}
      <path d="M8 4v3a3 3 0 003 3h2a3.5 3.5 0 010 7h-3a2.5 2.5 0 000 5"/><path d="M16 4v2"/>
    {%- when 'sparkle' -%}
      <path d="M12 4l1.8 4.9L19 10.5l-5.2 1.6L12 17l-1.8-4.9L5 10.5l5.2-1.6z"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'heart' -%}
      <path d="M12 19.5s-7.5-4.4-7.5-10A4.2 4.2 0 0112 7a4.2 4.2 0 017.5 2.5c0 5.6-7.5 10-7.5 10z"/>
    {%- when 'no-sugar' -%}
      <rect x="6" y="6" width="12" height="12" rx="2"/><path d="M4 20L20 4"/>
    {%- when 'vegan' -%}
      <path d="M4 5l8 15 8-15"/><path d="M14.5 9.5c1-2.5 3-3.6 5.5-3.5"/>
    {%- when 'flask' -%}
      <path d="M9.5 3.5h5M10 3.5v6L5 18a1.8 1.8 0 001.6 2.5h10.8A1.8 1.8 0 0019 18l-5-8.5v-6"/><path d="M7.5 14.5h9"/>
    {%- when 'lemon' -%}
      <ellipse cx="12" cy="12" rx="7.5" ry="6" transform="rotate(-35 12 12)"/><path d="M18.5 5.5l1.5-1.5M5.5 18.5L4 20"/>
    {%- when 'chevron' -%}
      <path d="M6 9l6 6 6-6"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'bacteria' -%}
      <ellipse cx="12" cy="12" rx="6.5" ry="4" transform="rotate(-30 12 12)"/><path d="M6.5 5.5l1.2 1.6M17.5 18.5l-1.2-1.6M4 10.5l2 .4M20 13.5l-2-.4M9.5 20l.6-2M14.5 4l-.6 2"/><circle cx="10.5" cy="12.5" r=".8"/><circle cx="13.5" cy="11" r=".8"/>
    {%- when 'wave' -%}
      <path d="M3 9c2.2 0 2.2-2 4.5-2S9.8 9 12 9s2.2-2 4.5-2S18.8 9 21 9M3 15c2.2 0 2.2-2 4.5-2s2.3 2 4.5 2 2.2-2 4.5-2 2.3 2 4.5 2"/>
    {%- when 'bloat' -%}
      <circle cx="12" cy="12.5" r="6.5"/><path d="M12 3v2.5M8.5 12.5h7M12 9v7"/>
    {%- when 'bolt' -%}
      <path d="M13 3L5.5 13.5H12L11 21l7.5-10.5H12z"/>
    {%- when 'gift' -%}
      <rect x="4" y="9" width="16" height="11" rx="1.5"/><path d="M3 9h18M12 9v11M12 9c-1.5-3.5-5.5-4-5.5-1.5S10 9 12 9zm0 0c1.5-3.5 5.5-4 5.5-1.5S14 9 12 9z"/>
    {%- when 'book' -%}
      <path d="M4 5.5A1.5 1.5 0 015.5 4H11v16H5.5A1.5 1.5 0 014 18.5zM20 5.5A1.5 1.5 0 0018.5 4H13v16h5.5a1.5 1.5 0 001.5-1.5z"/>
    {%- when 'lock' -%}
      <rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8 10.5V8a4 4 0 018 0v2.5"/>
    {%- when 'calendar' -%}
      <rect x="4" y="5.5" width="16" height="14.5" rx="2"/><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4"/>
    {%- when 'usa' -%}
      <rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="M3.5 10h17M3.5 14.5h17M3.5 5.5h7.5V10H3.5z"/>
    {%- when 'gmp' -%}
      <circle cx="12" cy="10" r="6"/><path d="M8.5 15l-1.5 6 5-2.5 5 2.5-1.5-6"/><path d="M9.5 10l1.7 1.7 3.3-3.4"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M8.5 12l2.4 2.4 4.6-4.8"/>
  {%- endcase -%}
</svg>
